# Copy this file to .env and fill in real values. .env is git-ignored.

APP_ENV=dev

# PostgreSQL + pgvector (matches docker-compose.yml)
DATABASE_URL=postgresql+psycopg://servicedesk:servicedesk@localhost:5432/servicedesk

# LLM provider: "openai" or "azure"
LLM_PROVIDER=openai

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-5-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Azure OpenAI (only needed when LLM_PROVIDER=azure) ---
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=

# --- Answers (RAG) ---
RAG_TOP_K=5
# Refuse without calling the model when the best source is less similar than this.
# Measured for text-embedding-3-small on the sample KB; re-measure if you change models.
RAG_MIN_SIMILARITY=0.35
# gpt-5 family: minimal | low | medium | high. Leave empty for non-reasoning models.
LLM_REASONING_EFFORT=low
LLM_TIMEOUT_SECONDS=60
